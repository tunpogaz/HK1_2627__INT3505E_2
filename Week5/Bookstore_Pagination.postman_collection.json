{
  "info": {
    "_postman_id": "b78b5980-8742-4fce-bc2e-13c5825a0a38",
    "name": "Bookstore API - Pagination & Filtering (Week 5)",
    "description": "Postman Collection hoàn chỉnh kiểm thử các chiến lược phân trang Offset vs Cursor, Filter by genre, Multi-key sort, Sparse fieldsets và xử lý lỗi theo chuẩn RESTful.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Cursor Pagination",
      "item": [
        {
          "name": "GET Books - Cursor Page 1 (Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has cursor pagination metadata', function () {",
                  "    pm.expect(jsonData.pagination.strategy).to.eql('cursor');",
                  "    pm.expect(jsonData.pagination.has_more).to.be.true;",
                  "    pm.expect(jsonData.pagination.next_cursor).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('nextCursor', jsonData.pagination.next_cursor);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=10&sort=-id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
                { "key": "strategy", "value": "cursor" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "-id" }
              ]
            },
            "description": "Lấy trang 1 sử dụng chiến thuật Cursor Pagination với limit=10, sort theo -id. Script test tự động lưu next_cursor vào biến môi trường."
          }
        },
        {
          "name": "GET Books - Cursor Next Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Next page returned items successfully', function () {",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=10&sort=-id&cursor={{nextCursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
                { "key": "strategy", "value": "cursor" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "-id" },
                { "key": "cursor", "value": "{{nextCursor}}" }
              ]
            },
            "description": "Lấy trang tiếp theo bằng cursor đã lưu từ request trước."
          }
        },
        {
          "name": "GET Books - Cursor with Sort by Price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=15&sort=price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
                { "key": "strategy", "value": "cursor" },
                { "key": "limit", "value": "15" },
                { "key": "sort", "value": "price" }
              ]
            },
            "description": "Kiểm thử cursor composite seek với cột sắp xếp có nhiều giá trị trùng nhau, hệ thống tự tie-break bằng id."
          }
        }
      ]
    },
    {
