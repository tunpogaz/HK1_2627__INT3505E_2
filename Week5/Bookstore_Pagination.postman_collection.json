                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?cursor=invalid_base64_payload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
