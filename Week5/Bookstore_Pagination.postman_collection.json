            "description": "Chỉ lấy các trường cần thiết nhằm tiết kiệm băng thông."
          }
        },
        {
          "name": "Validation - Reject Invalid Sort Column (400 Expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?sort=malicious_sql_inject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "books"],
              "query": [
                { "key": "sort", "value": "malicious_sql_inject" }
              ]
            },
            "description": "Kiểm thử cơ chế Sort Whitelisting ngăn chặn SQL Injection."
          }
        },
        {
          "name": "Validation - Reject Corrupted Cursor (400 Expected)",
          "event": [
            {
              "listen": "test",
              "script": {
